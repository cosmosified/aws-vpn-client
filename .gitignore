# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

build/*
connect/authorized_keys
*.log
.env
.envrc

# Local OpenVPN source/build artifacts
# `openvpn` is a symlink to build/openvpn-<version> created by the Makefile,
# used as a stable path for clangd (compile_flags.txt).
/openvpn
/openvpn.zip
